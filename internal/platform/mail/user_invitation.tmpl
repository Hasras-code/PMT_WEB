<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Verify your PMT Family email</title>
  </head>
  <body style="margin:0;padding:32px 16px;background:#101114;color:#f4f1e8;font-family:Arial,Helvetica,sans-serif;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:560px;margin:0 auto;background:#191a1f;border:1px solid #38352c;border-radius:16px;">
      <tr>
        <td style="padding:32px;">
          <p style="margin:0;color:#e3b83f;font-size:24px;font-weight:700;">PMT Family</p>
          <h1 style="margin:28px 0 12px;font-size:24px;line-height:1.3;">Verify your email address</h1>
          <p style="margin:0;color:#c6c3ba;font-size:16px;line-height:1.6;">Welcome! Confirm this email address to finish creating your student account.</p>
          <p style="margin:28px 0;">
            <a href="{{.VerificationURL}}" style="display:inline-block;padding:14px 22px;border-radius:10px;background:#e3b83f;color:#171717;font-size:16px;font-weight:700;text-decoration:none;">Verify email</a>
          </p>
          <p style="margin:0;color:#c6c3ba;font-size:14px;line-height:1.6;">If the button does not work, open this address in your browser:</p>
          <p style="margin:8px 0 24px;overflow-wrap:anywhere;font-size:13px;line-height:1.6;"><a href="{{.VerificationURL}}" style="color:#e3b83f;">{{.VerificationURL}}</a></p>
          <p style="margin:0;color:#c6c3ba;font-size:14px;line-height:1.6;">You can also enter this one-time token on the verification page:</p>
          <p style="margin:8px 0 0;padding:12px;background:#101114;border-radius:8px;font-family:monospace;font-size:14px;overflow-wrap:anywhere;">{{.Token}}</p>
          <p style="margin:28px 0 0;color:#85837d;font-size:12px;line-height:1.5;">If you did not create a PMT Family account, you can ignore this email.</p>
        </td>
      </tr>
    </table>
  </body>
</html>
