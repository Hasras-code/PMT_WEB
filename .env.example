APP_ENV=development
HTTP_ADDR=:8080
PUBLIC_API_URL=http://localhost:8080
DATABASE_URL=postgres://lms:lms_local_only@localhost:5432/lms?sslmode=disable
# Cloud Run runtime: store the complete URL in Google Secret Manager rather
# than this file. Percent-encode special characters in the password.
# DATABASE_URL=postgresql://postgres.bcwmnprcgemkgioiocum:PERCENT_ENCODED_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DB_MAX_CONNS=5
# Generate your own: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes-before-running
JWT_ISSUER=pmt-api
JWT_AUDIENCE=pmt-clients
STORAGE_DIR=./data/files
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
SMTP_ADDR=localhost:1025
MAIL_FROM=lms@localhost
COOKIE_SECURE=false
AUTH_BASIC_USER=admin
AUTH_BASIC_PASS=change-this-health-password
# Leave empty unless all listed networks are controlled reverse proxies.
TRUSTED_PROXY_CIDRS=
