# TEMP VPS config — copy to .env.vps and fill in. Never commit .env.vps.
#   cp deploy/vps-temp/.env.vps.example deploy/vps-temp/.env.vps
#
# Connection (recovered from previous sessions / repo history):
#   PMT temp VPS IP : 95.211.43.93 (public IPv4, no scheme, no port)
#   SSH             : ssh root@95.211.43.93  (run deploy steps on the VPS from repo root)
#   API host port   : 8090 (shared box: caddy owns localhost:8080,
#                     trading owns 8000/8501/6379/443 — do NOT touch those)
#   Frontend        : 80, Mailpit temp: 8025, Postgres: 127.0.0.1:5432 only
# NOTE: 95.211.126.202 (hermes trading agent, key ~/.ssh/hermes_vps) is a
# separate box — do not touch it from this bundle.
#
# Generate secrets with:
#   openssl rand -base64 48   # JWT_SECRET
#   openssl rand -base64 24   # POSTGRES_PASSWORD / AUTH_BASIC_PASS

# Public IPv4 of the VPS, no scheme, no port. Example: 95.211.43.93
VPS_IP=REPLACE_WITH_VPS_IP

# Host port for the API. 8090 default because the shared box already has
# localhost:8080 (caddy) and 8000/8501 (trading). Change only if occupied.
API_PORT=8090

# Postgres (used by postgres + migrate + api services in docker-compose.vps.yml)
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# API auth / health
JWT_SECRET=REPLACE_WITH_48B_RANDOM_SECRET
AUTH_BASIC_USER=admin
AUTH_BASIC_PASS=REPLACE_WITH_STRONG_HEALTH_PASSWORD

# Optional share-link mode: public HTTPS tunnel URL (e.g. cloudflared quick
# tunnel). When set, frontend API base, PUBLIC_API_URL and CORS all use it,
# so the app works fully over one https link (no mixed-content blocks).
# Leave empty for plain IP mode.
TUNNEL_URL=

# Frontend build arg (baked into Vite at docker build time)
# Keep in sync with VPS_IP + API_PORT. Direct-to-API mode for temp.
VITE_API_URL=http://REPLACE_WITH_VPS_IP:8090
